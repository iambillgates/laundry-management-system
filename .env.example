# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to git.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Django secret key (required). Must be a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Debug mode: True only for local development, False everywhere else.
DEBUG=False

# Comma-separated list of hostnames the app may serve, e.g.:
#   ALLOWED_HOSTS=localhost,127.0.0.1,laundry.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
